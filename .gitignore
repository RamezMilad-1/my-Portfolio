# dependencies
**/node_modules/

# builds
**/dist/
**/.next/
**/build/
**/coverage/
**/*.tsbuildinfo

# env
**/.env
**/.env.local
**/.env.*.local

# uploads are tracked so deployments (Render) ship the media files;
# note: files uploaded on the server after deploy live on ephemeral disk —
# download and commit them locally to keep them across redeploys.
backend/uploads/.DS_Store

# legacy backups
_legacy/

# local database snapshot (contains admin credentials hash + messages)
dump/

# installers
*.msi

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
