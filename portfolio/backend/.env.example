# =============================================================================
# Backend env — copy to .env for local dev. NEVER commit a real .env to git.
# =============================================================================

PORT=3000
MONGO_URI=mongodb://localhost:27017/ramez_portfolio
NODE_ENV=development

# -----------------------------------------------------------------------------
# JWT signing secret — REQUIRED. Must be a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Replace the value below before committing or deploying. Backend logs a
# loud warning at startup if it still equals the placeholder.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Cookie config.
# Local dev (frontend on :3000, backend on :3001 — same site):
#   COOKIE_SECURE=false
#   COOKIE_SAMESITE=lax
# Production with cross-origin (frontend on Vercel, backend on Render/Railway):
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
# Without these production values the auth cookie won't cross domains.
# -----------------------------------------------------------------------------
COOKIE_NAME=ramez_session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# Allowed origin(s) for CORS. Comma-separated list of fully-qualified URLs.
# Local dev: http://localhost:3000
# Production: https://your-portfolio-domain.com
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Where uploaded files (avatars, project gallery images, resumes) are stored.
# Path is relative to the backend's working directory.
# In production: this directory MUST be on persistent storage (e.g. Render disk)
# or uploads disappear on redeploy. Alternative: switch to S3/Cloudinary.
# -----------------------------------------------------------------------------
UPLOADS_DIR=./uploads
