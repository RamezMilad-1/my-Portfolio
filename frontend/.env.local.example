# Where the browser sends API requests. Locally: the backend directly.
# In production: /api/v1 (same origin, proxied to BACKEND_ORIGIN — see next.config.ts).
NEXT_PUBLIC_API_BASE=http://localhost:3001/api/v1

# Backend origin for server-side rendering and the production proxy. Optional locally.
# BACKEND_ORIGIN=http://localhost:3001

# Public URL of this site (sitemap, robots.txt, link previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match COOKIE_NAME on the backend (both default to ramez_session).
# SESSION_COOKIE_NAME=ramez_session
