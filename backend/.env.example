PORT=3001
NODE_ENV=development

# MongoDB Atlas connection string (or a local MongoDB for development)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ramez_portfolio

# Generate with: node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string

# Allow self-registration of admins at /createuser (true/false)
AUTH_REGISTER_ENABLED=false

# Cloudinary (image/video storage) — from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
