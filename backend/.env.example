PORT=3001
NODE_ENV=development

# MongoDB connection string (Atlas, or a local MongoDB for development)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ramez_portfolio

# Signs the admin session. In production it must be random and at least 32 characters:
#   node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string

# Session cookie. In production behind HTTPS set COOKIE_SECURE=true.
# COOKIE_NAME must match SESSION_COOKIE_NAME in the frontend (both default to ramez_session).
COOKIE_NAME=ramez_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Browser origins allowed to call the API with cookies (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Rate limiting identifies visitors by this header. Render sits behind Cloudflare, which sets
# cf-connecting-ip; leave it empty to use the socket address. TRUST_PROXY = proxy hops in front.
CLIENT_IP_HEADER=cf-connecting-ip
TRUST_PROXY=1

# Cloudinary (image/video/PDF storage) — from your Cloudinary dashboard. Required in production.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
